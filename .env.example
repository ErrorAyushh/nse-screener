# Copy this file to .env and fill in your own values. Never commit .env.


# Copy this file to .env and fill in your own values.
# Never commit .env or real credentials.

KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Written automatically by python auth_login.py. Leave blank.
KITE_ACCESS_TOKEN=
KITE_ACCESS_TOKEN_CREATED_AT=
# Screening defaults (comparisons are strictly greater-than)
MIN_MARKET_CAP_CR=1000
VOLUME_MULTIPLIER=4
REFRESH_INTERVAL_SECONDS=60

# Data quality
MARKET_CAP_CSV=data/market_cap.csv
MARKET_CAP_MAX_AGE_DAYS=190
QUOTE_STALE_SECONDS=300
PREV_CLOSE_TOLERANCE_PCT=1.0
HISTORY_LOOKBACK_DAYS=140
HISTORY_ONLY_WITH_MARKET_CAP=true

# Extra NSE series to include besides plain EQ symbols, comma separated (e.g. BE,BZ).
# Blank = EQ series only.
ALLOWED_SERIES_SUFFIXES=
